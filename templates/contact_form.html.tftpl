<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>お問い合わせ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0" rel="stylesheet">
  <style>
    :root {
      --clr-primary: #6750a4;
      --clr-primary-hover: #5b4397;
      --clr-primary-container: #eaddff;
      --clr-on-primary: #ffffff;
      --clr-secondary: #1a73e8;
      --clr-error: #b3261e;
      --clr-error-container: #fce8e6;
      --clr-success: #34a853;
      --clr-success-container: #e6f4ea;
      --clr-surface: #ffffff;
      --clr-surface-variant: #f7f2fa;
      --clr-outline: #cac4d0;
      --clr-outline-variant: #e8e0ec;
      --clr-on-surface: #1c1b1f;
      --clr-on-surface-muted: #49454f;
      --clr-on-surface-subtle: #79747e;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --shadow-1: 0 1px 2px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.08);
      --font-sans: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'Roboto Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      background: linear-gradient(135deg, #f0f4ff 0%, #faf0ff 50%, #f0f7ff 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
    }

    /* Top accent stripe */
    body::before {
      content: '';
      position: fixed;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, #6750a4 0%, #1a73e8 50%, #7b1fa2 100%);
      z-index: 999;
    }

    .card {
      background: var(--clr-surface);
      border: 1px solid var(--clr-outline-variant);
      border-radius: var(--radius-lg);
      padding: 2rem;
      width: 100%;
      max-width: 560px;
      box-shadow: var(--shadow-1);
    }

    /* Card header with gradient accent */
    .card-header {
      margin-bottom: 1.75rem;
    }
    .card-header-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--clr-primary-container);
      color: var(--clr-primary);
      font-size: 12px;
      font-weight: 500;
      padding: 4px 10px;
      border-radius: 100px;
      margin-bottom: 0.75rem;
    }
    .card-header-badge .material-symbols-outlined {
      font-size: 14px;
    }

    h2 {
      font-size: 20px;
      font-weight: 600;
      color: var(--clr-on-surface);
      margin-bottom: 0.25rem;
      letter-spacing: -0.01em;
    }

    .subtitle {
      font-size: 14px;
      color: var(--clr-on-surface-subtle);
      line-height: 1.5;
    }

    label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 500;
      color: var(--clr-on-surface-muted);
      margin-bottom: 6px;
    }
    label .material-symbols-outlined {
      font-size: 16px;
      color: var(--clr-primary);
      opacity: 0.7;
    }

    .required { color: var(--clr-error); margin-left: 2px; }

    .field { margin-bottom: 1rem; }

    input[type="text"],
    input[type="email"],
    textarea {
      width: 100%;
      padding: 10px 14px;
      font-size: 14px;
      font-family: var(--font-sans);
      border: 1.5px solid var(--clr-outline);
      border-radius: var(--radius-sm);
      outline: none;
      background: var(--clr-surface);
      color: var(--clr-on-surface);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    input::placeholder, textarea::placeholder {
      color: var(--clr-on-surface-subtle);
      opacity: 0.7;
    }
    input:focus, textarea:focus {
      border-color: var(--clr-primary);
      box-shadow: 0 0 0 3px rgba(103, 80, 164, 0.12);
    }
    textarea { resize: vertical; }

    .char-count {
      font-size: 12px;
      font-family: var(--font-mono);
      color: var(--clr-on-surface-subtle);
      text-align: right;
      margin-top: 4px;
    }
    .char-count.over { color: var(--clr-error); }

    .error-msg {
      display: none;
      background: var(--clr-error-container);
      border: 1px solid rgba(179, 38, 30, 0.3);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-size: 13px;
      color: var(--clr-error);
      margin-bottom: 1rem;
      align-items: center;
      gap: 8px;
    }
    .error-msg .material-symbols-outlined {
      font-size: 16px;
      flex-shrink: 0;
    }

    .btn-submit {
      width: 100%;
      padding: 12px;
      font-size: 15px;
      font-weight: 500;
      font-family: var(--font-sans);
      cursor: pointer;
      background: var(--clr-primary);
      color: var(--clr-on-primary);
      border: none;
      border-radius: var(--radius-md);
      letter-spacing: 0.01em;
      transition: background 0.2s, box-shadow 0.2s, opacity 0.2s;
      box-shadow: 0 1px 3px rgba(103, 80, 164, 0.3);
    }
    .btn-submit:hover {
      background: var(--clr-primary-hover);
      box-shadow: 0 2px 8px rgba(103, 80, 164, 0.35);
    }
    .btn-submit:active { opacity: 0.9; }
    .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; box-shadow: none; }

    .success-wrap {
      display: none;
      text-align: center;
      padding: 2rem 0;
    }
    .success-icon {
      width: 56px; height: 56px;
      border-radius: 50%;
      background: var(--clr-success-container);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem;
    }
    .success-icon .material-symbols-outlined {
      font-size: 28px;
      color: var(--clr-success);
    }
    .success-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--clr-on-surface);
      margin-bottom: 0.5rem;
    }
    .success-body {
      font-size: 14px;
      color: var(--clr-on-surface-subtle);
      margin-bottom: 1.75rem;
      line-height: 1.6;
    }
    .btn-reset {
      font-size: 14px;
      font-family: var(--font-sans);
      font-weight: 500;
      cursor: pointer;
      padding: 8px 24px;
      background: transparent;
      color: var(--clr-primary);
      border: 1.5px solid var(--clr-primary);
      border-radius: 100px;
      transition: background 0.2s;
    }
    .btn-reset:hover { background: var(--clr-primary-container); }

    @media (max-width: 600px) {
      .card { padding: 1.5rem; }
    }
  </style>
</head>
<body>
<div class="card">
  <div class="card-header">
    <div class="card-header-badge">
      <span class="material-symbols-outlined">mail</span>
      Contact
    </div>
    <h2>お問い合わせ</h2>
    <p class="subtitle">ご質問・ご意見はこちらからお送りください。</p>
  </div>

  <div id="form-body">
    <div class="field">
      <label>
        <span class="material-symbols-outlined">person</span>
        お名前 <span class="required">*</span>
      </label>
      <input type="text" id="name" placeholder="山田 太郎">
    </div>
    <div class="field">
      <label>
        <span class="material-symbols-outlined">alternate_email</span>
        メールアドレス <span class="required">*</span>
      </label>
      <input type="email" id="email" placeholder="taro@example.com">
    </div>
    <div class="field">
      <label>
        <span class="material-symbols-outlined">subject</span>
        件名
      </label>
      <input type="text" id="subject" placeholder="お問い合わせの件名">
    </div>
    <div class="field" style="margin-bottom:1.5rem;">
      <label>
        <span class="material-symbols-outlined">chat</span>
        お問い合わせ内容 <span class="required">*</span>
      </label>
      <textarea id="message" rows="5" placeholder="ご質問・ご意見をご記入ください"></textarea>
      <div id="char-count" class="char-count">0 / 500文字</div>
    </div>

    <div id="error-msg" class="error-msg">
      <span class="material-symbols-outlined">error</span>
      <span id="error-msg-text"></span>
    </div>

    <button id="submit-btn" class="btn-submit" onclick="handleSubmit()">送信する</button>
  </div>

  <div id="success-msg" class="success-wrap">
    <div class="success-icon">
      <span class="material-symbols-outlined">check_circle</span>
    </div>
    <p class="success-title">送信が完了しました</p>
    <p class="success-body">お問い合わせありがとうございます。<br>内容を確認次第、ご連絡いたします。</p>
    <button onclick="resetForm()" class="btn-reset">新しいお問い合わせ</button>
  </div>
</div>

<script>
  const API_ENDPOINT = "${api_endpoint}";
  const MAX = 500;
  const msgEl = document.getElementById('message');
  const countEl = document.getElementById('char-count');

  msgEl.addEventListener('input', () => {
    const len = msgEl.value.length;
    countEl.textContent = len + ' / ' + MAX + '文字';
    countEl.className = 'char-count' + (len > MAX ? ' over' : '');
  });

  function showError(msg) {
    const errEl = document.getElementById('error-msg');
    document.getElementById('error-msg-text').textContent = msg;
    errEl.style.display = 'flex';
  }

  async function handleSubmit() {
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const subject = document.getElementById('subject').value.trim();
    const message = document.getElementById('message').value.trim();
    const errEl = document.getElementById('error-msg');
    const btn = document.getElementById('submit-btn');

    errEl.style.display = 'none';

    if (!name || !email || !message) {
      showError('※ お名前・メールアドレス・お問い合わせ内容は必須項目です。');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError('※ 正しいメールアドレスを入力してください。');
      return;
    }
    if (message.length > MAX) {
      showError('※ お問い合わせ内容は' + MAX + '文字以内で入力してください。');
      return;
    }

    btn.disabled = true;
    btn.textContent = '送信中...';

    try {
      const res = await fetch(API_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, subject, message })
      });

      if (!res.ok) throw new Error('API error: ' + res.status);

      document.getElementById('form-body').style.display = 'none';
      document.getElementById('success-msg').style.display = 'block';
    } catch (e) {
      showError('※ 送信に失敗しました。しばらくしてから再度お試しください。');
      btn.disabled = false;
      btn.textContent = '送信する';
    }
  }

  function resetForm() {
    ['name', 'email', 'subject', 'message'].forEach(id => {
      document.getElementById(id).value = '';
    });
    countEl.textContent = '0 / ' + MAX + '文字';
    countEl.className = 'char-count';
    document.getElementById('error-msg').style.display = 'none';
    document.getElementById('form-body').style.display = 'block';
    document.getElementById('success-msg').style.display = 'none';
    document.getElementById('submit-btn').disabled = false;
    document.getElementById('submit-btn').textContent = '送信する';
  }
</script>
</body>
</html>
