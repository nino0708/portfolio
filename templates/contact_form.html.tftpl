<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>お問い合わせ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
  <style>
    :root {
      --primary: #4285F4;
      --primary-dark: #3367D6;
      --primary-light: rgba(66, 133, 244, 0.10);
      --primary-surface: rgba(66, 133, 244, 0.06);
      --gradient-hero: linear-gradient(135deg, #4285F4 0%, #7B4EA8 100%);
      --bg: #F3F4F8;
      --surface: #ffffff;
      --border: #E2E8F0;
      --border-focus: #4285F4;
      --text: #1A1A2E;
      --text-secondary: #5F6368;
      --text-placeholder: #9AA0A6;
      --error: #D93025;
      --error-bg: #FCE8E6;
      --error-border: #F28B82;
      --success: #188038;
      --success-bg: #E6F4EA;
      --font: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font);
      background: var(--bg);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Hero Banner */
    .hero {
      width: 100%;
      background: var(--gradient-hero);
      padding: 3rem 1rem 4.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      color: #fff;
    }
    .hero-icon {
      font-size: 40px;
      margin-bottom: 0.75rem;
      opacity: 0.92;
    }
    .hero-title {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: 0.02em;
      margin-bottom: 0.4rem;
    }
    .hero-sub {
      font-size: 13px;
      opacity: 0.72;
      letter-spacing: 0.06em;
    }

    /* Card lift out of hero */
    .card-wrap {
      width: 100%;
      max-width: 580px;
      padding: 0 1rem 3rem;
      margin-top: -2.5rem;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      width: 100%;
      box-shadow: 0 4px 24px rgba(66, 133, 244, 0.08), 0 1px 6px rgba(0, 0, 0, 0.06);
    }
    h2 {
      font-size: 17px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.25rem;
    }
    .subtitle {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }
    label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--text-secondary);
      margin-bottom: 6px;
    }
    .required { color: var(--error); }
    .field { margin-bottom: 1rem; }
    input[type="text"],
    input[type="email"],
    textarea {
      width: 100%;
      padding: 10px 14px;
      font-size: 14px;
      font-family: var(--font);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      outline: none;
      color: var(--text);
      background: #FAFBFF;
      transition: border-color 0.18s, box-shadow 0.18s;
    }
    input[type="text"]::placeholder,
    input[type="email"]::placeholder,
    textarea::placeholder { color: var(--text-placeholder); }
    input:focus, textarea:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px var(--primary-light);
      background: #fff;
    }
    textarea { resize: vertical; }
    .char-count {
      font-size: 12px;
      color: var(--text-placeholder);
      text-align: right;
      margin-top: 4px;
      font-family: 'Roboto Mono', monospace;
    }
    .char-count.over { color: var(--error); }
    .error-msg {
      display: none;
      background: var(--error-bg);
      border: 1px solid var(--error-border);
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 13px;
      color: var(--error);
      margin-bottom: 1rem;
    }
    .btn-submit {
      width: 100%;
      padding: 12px;
      font-size: 15px;
      font-weight: 700;
      font-family: var(--font);
      cursor: pointer;
      background: var(--primary);
      color: #fff;
      border: none;
      border-radius: 10px;
      letter-spacing: 0.03em;
      transition: background 0.18s, box-shadow 0.18s, transform 0.1s;
      box-shadow: 0 2px 8px rgba(66, 133, 244, 0.30);
    }
    .btn-submit:hover {
      background: var(--primary-dark);
      box-shadow: 0 4px 16px rgba(66, 133, 244, 0.35);
    }
    .btn-submit:active { transform: scale(0.99); }
    .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    /* Success */
    .success-wrap {
      display: none;
      text-align: center;
      padding: 2rem 0;
    }
    .success-icon {
      width: 56px; height: 56px;
      border-radius: 50%;
      background: var(--success-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
    }
    .success-title {
      font-size: 17px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .success-body {
      font-size: 14px;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.7;
    }
    .btn-reset {
      font-size: 14px;
      cursor: pointer;
      padding: 9px 24px;
      background: transparent;
      color: var(--primary);
      border: 1.5px solid var(--primary);
      border-radius: 10px;
      font-family: var(--font);
      font-weight: 500;
      transition: background 0.15s;
    }
    .btn-reset:hover { background: var(--primary-surface); }
  </style>
</head>
<body>

<div class="hero">
  <span class="material-symbols-outlined hero-icon">mail</span>
  <h1 class="hero-title">お問い合わせ</h1>
  <p class="hero-sub">二瀬 樹 ポートフォリオ</p>
</div>

<div class="card-wrap">
<div class="card">
  <h2>お問い合わせ</h2>
  <p class="subtitle">ご質問・ご意見はこちらからお送りください。</p>

  <div id="form-body">
    <div class="field">
      <label>お名前 <span class="required">*</span></label>
      <input type="text" id="name" placeholder="山田 太郎">
    </div>
    <div class="field">
      <label>メールアドレス <span class="required">*</span></label>
      <input type="email" id="email" placeholder="taro@example.com">
    </div>
    <div class="field">
      <label>件名</label>
      <input type="text" id="subject" placeholder="お問い合わせの件名">
    </div>
    <div class="field" style="margin-bottom:1.5rem;">
      <label>お問い合わせ内容 <span class="required">*</span></label>
      <textarea id="message" rows="5" placeholder="ご質問・ご意見をご記入ください"></textarea>
      <div id="char-count" class="char-count">0 / 500文字</div>
    </div>

    <div id="error-msg" class="error-msg"></div>

    <button id="submit-btn" class="btn-submit" onclick="handleSubmit()">送信する</button>
  </div>

  <div id="success-msg" class="success-wrap">
    <div class="success-icon">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
        <path d="M6 13l5.5 5.5L20 8" stroke="#188038" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <p class="success-title">送信が完了しました</p>
    <p class="success-body">お問い合わせありがとうございます。<br>内容を確認次第、ご連絡いたします。</p>
    <button onclick="resetForm()" class="btn-reset">新しいお問い合わせ</button>
  </div>
</div>
</div>

<script>
  const API_ENDPOINT = "${api_endpoint}";
  const MAX = 500;
  const msgEl = document.getElementById('message');
  const countEl = document.getElementById('char-count');

  msgEl.addEventListener('input', () => {
    const len = msgEl.value.length;
    countEl.textContent = len + ' / ' + MAX + '文字';
    countEl.className = 'char-count' + (len > MAX ? ' over' : '');
  });

  async function handleSubmit() {
    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const subject = document.getElementById('subject').value.trim();
    const message = document.getElementById('message').value.trim();
    const errEl = document.getElementById('error-msg');
    const btn = document.getElementById('submit-btn');

    errEl.style.display = 'none';

    if (!name || !email || !message) {
      errEl.textContent = '※ お名前・メールアドレス・お問い合わせ内容は必須項目です。';
      errEl.style.display = 'block';
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = '※ 正しいメールアドレスを入力してください。';
      errEl.style.display = 'block';
      return;
    }
    if (message.length > MAX) {
      errEl.textContent = '※ お問い合わせ内容は' + MAX + '文字以内で入力してください。';
      errEl.style.display = 'block';
      return;
    }

    btn.disabled = true;
    btn.textContent = '送信中...';

    try {
      const res = await fetch(API_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, subject, message })
      });

      if (!res.ok) throw new Error('API error: ' + res.status);

      document.getElementById('form-body').style.display = 'none';
      document.getElementById('success-msg').style.display = 'block';
    } catch (e) {
      errEl.textContent = '※ 送信に失敗しました。しばらくしてから再度お試しください。';
      errEl.style.display = 'block';
      btn.disabled = false;
      btn.textContent = '送信する';
    }
  }

  function resetForm() {
    ['name', 'email', 'subject', 'message'].forEach(id => {
      document.getElementById(id).value = '';
    });
    countEl.textContent = '0 / ' + MAX + '文字';
    countEl.className = 'char-count';
    document.getElementById('error-msg').style.display = 'none';
    document.getElementById('form-body').style.display = 'block';
    document.getElementById('success-msg').style.display = 'none';
    document.getElementById('submit-btn').disabled = false;
    document.getElementById('submit-btn').textContent = '送信する';
  }
</script>
</body>
</html>
